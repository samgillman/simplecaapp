#!/usr/bin/env bash

set -eu

allowed_name="samgillman"
allowed_email="samggillman@gmail.com"
zero_oid="0000000000000000000000000000000000000000"
invalid=0

while read -r local_ref local_oid remote_ref remote_oid; do
  if [ "$local_oid" = "$zero_oid" ]; then
    continue
  fi

  if [ "$remote_oid" = "$zero_oid" ]; then
    commits="$(git rev-list "$local_oid" --not --remotes)"
  else
    commits="$(git rev-list "$remote_oid..$local_oid")"
  fi

  for commit_oid in $commits; do
    author="$(git show -s --format='%an|%ae' "$commit_oid")"
    committer="$(git show -s --format='%cn|%ce' "$commit_oid")"

    if [ "$author" != "$allowed_name|$allowed_email" ] ||
       [ "$committer" != "$allowed_name|$allowed_email" ]; then
      echo "Push blocked: $commit_oid is not authored and committed as $allowed_name <$allowed_email>." >&2
      invalid=1
    fi

    if git show -s --format='%B' "$commit_oid" | grep -Eiq '^[[:space:]]*Co-Authored-By:'; then
      echo "Push blocked: $commit_oid contains a co-author trailer." >&2
      invalid=1
    fi
  done
done

exit "$invalid"
